{
  "name": "bookkeeping-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets Claude and other AI assistants do real bookkeeping on your own files: summarise bank statements, reconcile them with invoices (confidence + reasons), and create print-ready invoices with sales tax. Runs locally.",
  "type": "module",
  "main": "./src/server.js",
  "exports": {
    ".": "./src/server.js"
  },
  "bin": {
    "bookkeeping-mcp": "bin/bookkeeping-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/bookkeeping-mcp.js",
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "bookkeeping",
    "accounting",
    "bank-reconciliation",
    "invoice",
    "sales-tax",
    "ai-tools",
    "small-business",
    "pakistan"
  ],
  "author": "mubasher1111",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mubasher1111/bookkeeping-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mubasher1111/bookkeeping-mcp/issues"
  },
  "homepage": "https://zexcart.site/bookkeeping-mcp/",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "pk-invoice": "^1.0.0",
    "reconcile-kit": "^1.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
